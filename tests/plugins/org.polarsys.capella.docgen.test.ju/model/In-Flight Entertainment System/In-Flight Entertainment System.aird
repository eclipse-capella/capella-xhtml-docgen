  <diagram:DSemanticDiagram uid="_3blN8KK2Ed6k26nfEmjK4A">
    <ownedAnnotationEntries xmi:type="description:AnnotationEntry" uid="_Ps2I0r2KEeK5YJPLmxlV8A" source="GMF_DIAGRAMS">
      <data xmi:type="notation:Diagram" xmi:id="_CTGKINLHEd6Vfu18JJxfmA" type="Sirius" element="_3blN8KK2Ed6k26nfEmjK4A" measurementUnit="Pixel">
        <children xmi:type="notation:Node" xmi:id="_CTGKIdLHEd6Vfu18JJxfmA" type="Note">
          <children xmi:type="notation:Node" xmi:id="_CTGKItLHEd6Vfu18JJxfmA" type="DiagramName">
            <element xsi:nil="true"/>
          </children>
          <children xmi:type="notation:Node" xmi:id="_CTGKI9LHEd6Vfu18JJxfmA" type="Description">
            <element xsi:nil="true"/>
          </children>
          <styles xmi:type="notation:ShapeStyle" xmi:id="_CTGKJNLHEd6Vfu18JJxfmA" fontName="Segoe UI" description="ARCHITECTURE DRIVER #3&#xD;&#xA;&#xD;&#xA;Architecture patterns are implemented to anticipate product customisation and product line policy.&#xD;&#xA;&#xD;&#xA;- Product Customisation: Aircraft- and airline-specific functionality are segregated in separated components in order to be easily removed  / replaced.  &#xD;&#xA;&#xD;&#xA;- Product Line Policy:  Variability in core components can be managed through a separate viewpoint allowing to express variability in components' functions and interfaces. &#xD;&#xA;This is not illustrated in this sample model.&#xD;&#xA; " fillColor="13491414" transparency="0" lineColor="8421504" lineWidth="1"/>
          <element xsi:nil="true"/>
          <layoutConstraint xmi:type="notation:Bounds" xmi:id="_CTGKJdLHEd6Vfu18JJxfmA" y="460" width="1791" height="261"/>
        </children>
        <children xmi:type="notation:Node" xmi:id="_CTGKJtLHEd6Vfu18JJxfmA" type="Note">
          <children xmi:type="notation:Node" xmi:id="_CTGKJ9LHEd6Vfu18JJxfmA" type="DiagramName">
            <element xsi:nil="true"/>
          </children>
          <children xmi:type="notation:Node" xmi:id="_CTGKKNLHEd6Vfu18JJxfmA" type="Description">
            <element xsi:nil="true"/>
          </children>
          <styles xmi:type="notation:ShapeStyle" xmi:id="_CTGKKdLHEd6Vfu18JJxfmA" fontName="Segoe UI" description="ARCHITECTURE DRIVER #2 :&#xD;&#xA;&#xD;&#xA;Functional grouping of functions to reduce interfaces, optimize performance, etc." fillColor="15852768" transparency="0" lineColor="8421504" lineWidth="1"/>
          <element xsi:nil="true"/>
          <layoutConstraint xmi:type="notation:Bounds" xmi:id="_CTGKKtLHEd6Vfu18JJxfmA" x="20" y="240" width="1781" height="161"/>
        </children>
        <children xmi:type="notation:Node" xmi:id="_CTGKK9LHEd6Vfu18JJxfmA" type="Note">
          <children xmi:type="notation:Node" xmi:id="_CTGKLNLHEd6Vfu18JJxfmA" type="DiagramName">
            <element xsi:nil="true"/>
          </children>
          <children xmi:type="notation:Node" xmi:id="_CTGKLdLHEd6Vfu18JJxfmA" type="Description">
            <element xsi:nil="true"/>
          </children>
          <styles xmi:type="notation:ShapeStyle" xmi:id="_CTGKLtLHEd6Vfu18JJxfmA" fontName="Segoe UI" description="ARCHITECTURE DRIVER #1 : &#xD;&#xA;&#xD;&#xA;Organization of the architecture in 4 main parts in order to take into account the topology of the aircraft and anticipate integration concerns: &#xD;&#xA;- Front Servers&#xD;&#xA;- Cabin Terminal for Cabin Crew and Maintenance&#xD;&#xA;- Private TV on Seats &#xD;&#xA;- Cabin Screens&#xD;&#xA;" fillColor="15133164" transparency="0" lineColor="8421504" lineWidth="1"/>
          <element xsi:nil="true"/>
          <layoutConstraint xmi:type="notation:Bounds" xmi:id="_CTGKL9LHEd6Vfu18JJxfmA" x="20" y="20" width="1781" height="165"/>
