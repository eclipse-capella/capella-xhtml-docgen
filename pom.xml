<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.polarsys</groupId>
		<artifactId>org.polarsys.capella.addons-common.releng.parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>

	<artifactId>org.polarsys.capella.addon.docgen</artifactId>
	<version>${releaseVersion}${qualifier}</version>
	<packaging>pom</packaging>

	<name>Capella Add-on XHTML Documentation Generation</name>

	<modules>
		<module>docgenhtml/features</module>
		<module>docgenhtml/plugins</module>
		<module>releng/org.polarsys.capella.docgen.site</module>
		<module>tests/plugins</module>
	</modules>

	<properties>
		<addon.name>CapellaXHTMLDocGen</addon.name>
		<addon.tp.artifactId>org.polarsys.capella.addon.docgen</addon.tp.artifactId>
		<addon.tp.classifier>releng/org.polarsys.capella.docgen.target/tp/capella.target-definition</addon.tp.classifier>
		<addon.tp.groupId>org.polarsys</addon.tp.groupId>
		<addon.tp.version>${addon.version}</addon.tp.version>
		<addon.tpd.path>tp/capella.target-definition.targetplatform</addon.tpd.path>
		<addon.version>${releaseVersion}${qualifier}</addon.version>
		<tycho.sbom.url>https://download.eclipse.org/capella/addons/xhtmldocgen/</tycho.sbom.url>
		<tycho.scmUrl>scm:git:https://github.com/eclipse-capella/capella-xhtml-docgen.git</tycho.scmUrl>
	</properties>

	<build>
		<plugins>
			<!-- Ensures this parent module has provided values for all the properties expected by the common parent POM -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<!-- We do not want to execute this plugin in child modules -->
				<inherited>false</inherited>
				<executions>
					<execution>
						<id>check-addon-properties</id>
						<phase>validate</phase>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
